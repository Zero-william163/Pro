<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget Provider Info (Base — API 24+)

    Minimal attributes for maximum launcher compatibility.
    API 31+ attributes (description, targetCellWidth, targetCellHeight)
    are in xml-v31/countdown_widget_info.xml.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_countdown"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
