<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget Provider Info

    Configured for modern Android widget experience:
    - 3x2 grid cells (compact but readable)
    - Resizable both directions
    - 30-min update period (system minimum)
    - Light/dark mode auto-adapt via resource qualifiers
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_countdown"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/ic_launcher_foreground"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:description="@string/widget_description" />
