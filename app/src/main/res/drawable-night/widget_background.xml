<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget - Background (Dark Mode auto-adapt)

    When the system is in dark mode, this file is automatically used
    instead of drawable/widget_background.xml, ensuring the widget
    always has the correct background even if the receiver fails to run.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Dark gradient main layer -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/widget_gradient_start"
                android:endColor="@color/widget_gradient_end" />
            <corners android:radius="23dp" />
        </shape>
    </item>

</layer-list>
