<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget - Layout

    IMPORTANT: Only use RemoteViews-supported views!
    Supported: LinearLayout, RelativeLayout, FrameLayout, GridLayout,
               TextView, ImageView, Button, ImageButton, ProgressBar,
               Chronometer, AnalogClock, TextClock, ViewStub

    DO NOT USE: View (NOT supported!), Space, RecyclerView, etc.

    All colors are hardcoded to avoid resource resolution failures.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ===== Top: Event Name ===== -->
    <TextView
        android:id="@+id/widget_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="事件"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- ===== Center: Super-large countdown number + unit ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="56sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="天"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Divider (using TextView instead of View — View is NOT RemoteViews-supported!) ===== -->
    <TextView
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#55FFFFFF"
        android:text="" />

    <!-- ===== Bottom: Target Date + Reminder Time (vertical to prevent truncation) ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目标日期"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_reminder_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="未设置提醒"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
