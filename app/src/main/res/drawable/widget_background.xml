<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget - Background (Light Mode)

    Simple shape with gradient — maximum RemoteViews compatibility.
    No layer-list (some launchers have issues with it).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="135"
        android:startColor="#FF4F46E5"
        android:endColor="#FF0EA5E9" />

    <corners android:radius="24dp" />

</shape>
