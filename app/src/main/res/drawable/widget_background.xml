<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget - Background (Light Mode)

    Uses hardcoded colors to avoid RemoteViews resource resolution issues
    on certain launchers (Huawei, MIUI, etc.)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Gradient main layer: Indigo → Sky Blue -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF4F46E5"
                android:endColor="#FF0EA5E9" />
            <corners android:radius="23dp" />
        </shape>
    </item>

</layer-list>
