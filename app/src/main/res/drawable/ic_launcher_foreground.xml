<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown App - Launcher Icon Foreground

    Design: A bold, premium hourglass symbolizing countdown/time.
    Features frosted glass body (semi-transparent) with white outline,
    solid white sand visible through the glass, and thick rounded plates.

    Optimized for maximum clarity and premium feel at all sizes (48dp+).
    Centered within the 108x108 viewport, safe zone (66x66) compliant.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ===== Layer 1: Glass body (semi-transparent for frosted glass effect) ===== -->

    <!-- Upper glass body: curved shape from top plate down to center pinch -->
    <path
        android:fillColor="#50FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M35,34 L73,34 C73,34 66,44 60,49 C57,51 55,53 54,54 C53,53 51,51 48,49 C42,44 35,34 35,34 Z" />

    <!-- Lower glass body: curved shape from center pinch down to bottom plate -->
    <path
        android:fillColor="#50FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M35,74 L73,74 C73,74 66,64 60,59 C57,57 55,55 54,54 C53,55 51,57 48,59 C42,64 35,74 35,74 Z" />

    <!-- ===== Layer 2: Sand (solid white, visible through semi-transparent glass) ===== -->

    <!-- Sand in upper chamber (funnel shape flowing down) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,36 L67,36 C67,36 61,43 57,46.5 C55.5,47.5 54.5,49 54,50 C53.5,49 52.5,47.5 51,46.5 C47,43 41,36 41,36 Z" />

    <!-- Sand stream (thin falling line from pinch) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M53.5,55 L54.5,55 L54.5,62 L53.5,62 Z" />

    <!-- Sand pile in lower chamber (growing mound) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47,72 C47,72 50,67 54,67 C58,67 61,72 61,72 Z" />

    <!-- ===== Layer 3: Plates (solid white, drawn last to cover glass body edges) ===== -->

    <!-- Top plate (thick, rounded corners) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,29 L74,29 Q76,29 76,31 L76,32 Q76,34 74,34 L34,34 Q32,34 32,32 L32,31 Q32,29 34,29 Z" />

    <!-- Bottom plate (thick, rounded corners) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,74 L74,74 Q76,74 76,76 L76,77 Q76,79 74,79 L34,79 Q32,79 32,77 L32,76 Q32,74 34,74 Z" />

</vector>
