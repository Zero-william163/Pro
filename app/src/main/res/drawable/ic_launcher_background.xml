<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown App - Launcher Icon Background

    Premium vibrant gradient inspired by top-tier apps (WeChat, WPS).
    Blue → Purple → Pink diagonal gradient with radial highlights for depth.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base diagonal gradient: blue → purple → pink -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF1565C0"
                android:centerColor="#FF7B1FA2"
                android:endColor="#FFC2185B" />
        </aapt:attr>
    </path>

    <!-- Top-left radial glow for depth and premium feel -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="28"
                android:centerY="26"
                android:gradientRadius="68"
                android:startColor="#35FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Bottom-right subtle shadow for dimensionality -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="85"
                android:centerY="85"
                android:gradientRadius="55"
                android:startColor="#18000000"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

</vector>
