<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown App - Launcher Icon Background

    Gradient: Indigo (#4F46E5) → Violet (#7C3AED)
    Diagonal 135° gradient for premium depth.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF4F46E5"
                android:endColor="#FF7C3AED" />
        </aapt:attr>
    </path>

    <!-- Subtle radial highlight for depth -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="35"
                android:gradientRadius="80"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
