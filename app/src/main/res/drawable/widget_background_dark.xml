<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget - Background (Dark Mode)

    Simple shape with gradient — maximum RemoteViews compatibility.
    No layer-list (some launchers have issues with it).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="135"
        android:startColor="#FF312E81"
        android:endColor="#FF0C4A6E" />

    <corners android:radius="24dp" />

</shape>
