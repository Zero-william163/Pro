<?xml version="1.0" encoding="utf-8"?>
<!--
    Countdown Widget - Background (Dark Mode)

    Darker gradient for night mode: Deep Indigo → Dark Navy
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Dark gradient main layer -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF312E81"
                android:endColor="#FF0C4A6E" />
            <corners android:radius="23dp" />
        </shape>
    </item>

</layer-list>
